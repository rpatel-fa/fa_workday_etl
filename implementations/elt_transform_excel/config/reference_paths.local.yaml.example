# reference_paths.local.yaml.example
#
# Per-host override for config/reference_paths.yaml. Copy this file to
# "reference_paths.local.yaml" (same folder) and fill in only the keys your build host
# needs to override — omitted keys still fall back to reference_paths.yaml.
#
# WHY THIS EXISTS
# reference_paths.yaml is the committed, canonical source of truth for the three shared
# reference workbooks (Customer extract, Supplier extract, Mapping MASTER). It is currently
# authored with one person's local paths. Those files commonly live at unrelated, per-person
# locations across build hosts (not a fixed cross-platform mirror), so a build-time path
# rewrite (like path_substitutions.yaml uses for the vba_src bootstrap folder) can't derive
# one from the other. This local override file lets each host point at its own copies
# without editing the tracked reference_paths.yaml.
#
# "reference_paths.local.yaml" (no ".example") is gitignored — safe to fill in with your
# own machine-specific paths; it will never be committed. See docs/BUILD_WIN.md ("Before
# Step 2") and docs/CONFIGURATION.md ("Shared reference-data paths").
version: 1

reference_paths:
  customer_spreadsheet: C:\path\to\your\Extract_Customers.xlsx
  supplier_spreadsheet: C:\path\to\your\Extract_Suppliers.xlsx
  mapping_spreadsheet: C:\path\to\your\Mapping MASTER.xlsx
  # mapping_sheet: MAPPING MASTER   # usually unchanged; override only if the tab name differs
